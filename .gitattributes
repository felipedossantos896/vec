# Evita avisos de fim de linha entre Windows e Linux
* text=auto
*.go text eol=lf
*.sql text eol=lf
*.html text eol=lf

# Bibliotecas de terceiros: bytes exatos do pacote (hashes em VERSAO.txt)
frontend/admin/vendor/** -text

# Fontes (Spec 008): binárias, bytes exatos (hashes em frontend/fonts/VERSAO.txt)
frontend/fonts/*.woff2 binary
