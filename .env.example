# Copie este arquivo para ".env" e preencha. O ".env" NÃO vai para o GitHub.

# Banco de DESENVOLVIMENTO no Turso (nunca use o de produção no seu notebook)
TURSO_DATABASE_URL=libsql://vec-dev-SEU-USUARIO.aws-sa-east-1.turso.io
TURSO_AUTH_TOKEN=

# Segredo que assina as sessões (gere com: go run ./cmd/segredo)
SESSION_SECRET=

# Porta local
PORT=8080

# 1 = aplica migrations ao iniciar (recomendado). 0 = desliga.
AUTO_MIGRATE=1
