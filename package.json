{
  "name": "vec",
  "private": true,
  "scripts": {
    "build": "npm run build:css && tsc --project frontend/tsconfig.json",
    "build:css": "tailwindcss -i frontend/tailwind.input.css -o frontend/tailwind.css --minify",
    "test:frontend": "tsc --project frontend/tsconfig.json && node --test frontend/test/*.test.js",
    "typecheck": "tsc --project frontend/tsconfig.json --noEmit",
    "test:e2e:dev": "node scripts/e2e/dev-smoke.mjs"
  },
  "devDependencies": {
    "playwright": "1.64.1",
    "tailwindcss": "^3.4.19",
    "typescript": "^7.0.2"
  }
}
